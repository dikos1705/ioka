APP_NAME=Ioka Flight Booking API
APP_ENV=docker
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ioka:ioka@postgres:5432/ioka
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
SEARCH_DISPATCH_MODE=rabbitmq
SEARCH_TIMEOUT_SECONDS=20
PROVIDER_TIMEOUT_SECONDS=15
SEARCH_TTL_SECONDS=900
JWT_SECRET=local-docker-secret-change-before-production
JWT_ISSUER=ioka-flight-booking
JWT_AUDIENCE=ioka-agents
JWT_TTL_MINUTES=60
DEFAULT_AGENT_EMAIL=agent@ioka.local
DEFAULT_AGENT_PASSWORD=ChangeMe123!
DEFAULT_AGENT_BALANCE=10000000.00
AUTO_CREATE_SCHEMA=false
